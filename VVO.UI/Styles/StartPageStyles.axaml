<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <StackPanel Classes="StartPage" Width="{StaticResource StartPageContentWidth}">
            <StackPanel Classes="BigButtonsGroup">
                <Button Classes="BigButton">
                    <StackPanel>
                        <PathIcon Data="{StaticResource FilePlus}"/>
                        <TextBlock Text="New Database"/>
                    </StackPanel>
                </Button>
                <Button Classes="BigButton">
                    <StackPanel>
                        <PathIcon Data="{StaticResource FileOpenRound}"/>
                        <TextBlock Text="Open Database"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Classes="RecentGroup">
                <TextBlock Classes="RecentHeading" Text="Recent"/>
                <Grid Classes="RecentRow" ColumnDefinitions="*, Auto">
                    <Button Classes="RecentLink">
                        <Grid ColumnDefinitions="Auto, *">
                            <TextBlock Grid.Column="0" Classes="RecentName" Text="File"/>
                            <TextBlock Grid.Column="1" Classes="RecentPath" Text="/folder/path"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Classes="RecentRemove">
                        <PathIcon Data="{StaticResource Close}"/>
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="StackPanel.StartPage">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Spacing" Value="28"/>
    </Style>

    <Style Selector="StackPanel.BigButtonsGroup">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Spacing" Value="12"/>
    </Style>

    <!-- Icon and caption are one control, so the whole tile lights up and answers a click -->
    <Style Selector="Button.BigButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="22,18"/>
    </Style>

    <Style Selector="Button.BigButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="Button.BigButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
    </Style>

    <Style Selector="Button.BigButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}"/>
    </Style>

    <Style Selector="Button.BigButton > StackPanel">
        <Setter Property="Spacing" Value="10"/>
    </Style>

    <Style Selector="Button.BigButton PathIcon">
        <Setter Property="Width" Value="{StaticResource StartPageIconSize}"/>
        <Setter Property="Height" Value="{StaticResource StartPageIconSize}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
    </Style>

    <Style Selector="Button.BigButton TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{StaticResource StartPageCaptionFontSize}"/>
    </Style>

    <Style Selector="StackPanel.RecentGroup">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Spacing" Value="8"/>
    </Style>

    <Style Selector="TextBlock.RecentHeading">
        <Setter Property="FontSize" Value="{StaticResource StartPageHeadingFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style Selector="TextBlock.EmptyHint">
        <Setter Property="FontSize" Value="{StaticResource StartPageItemPathFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <!-- A database that is no longer where it was recedes, but stays available to remove -->
    <Style Selector="Grid.RecentRow.Missing Button.RecentLink">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="Grid.RecentRow.Missing TextBlock.RecentName">
        <Setter Property="TextDecorations" Value="Strikethrough"/>
    </Style>

    <Style Selector="Button.RecentLink">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Button.RecentLink:pointerover TextBlock.RecentName">
        <Setter Property="TextDecorations" Value="Underline"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
    </Style>

    <Style Selector="Button.RecentLink:pointerover TextBlock.RecentPath">
        <Setter Property="TextDecorations" Value="Underline"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
    </Style>

    <Style Selector="Button.RecentLink /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Button.RecentLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
    </Style>

    <Style Selector="TextBlock.RecentName">
        <Setter Property="FontSize" Value="{StaticResource StartPageItemFontSize}"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.RecentPath">
        <Setter Property="FontSize" Value="{StaticResource StartPageItemPathFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Kept in the layout at all times so rows do not shift as the pointer crosses them -->
    <Style Selector="Button.RecentRemove">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style Selector="Grid.RecentRow:pointerover Button.RecentRemove">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>

    <Style Selector="Button.RecentRemove PathIcon">
        <Setter Property="Width" Value="{StaticResource IconChevron}"/>
        <Setter Property="Height" Value="{StaticResource IconChevron}"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
    </Style>

    <Style Selector="Button.RecentRemove:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource DiffRemovedForeground}"/>
    </Style>
</Styles>
