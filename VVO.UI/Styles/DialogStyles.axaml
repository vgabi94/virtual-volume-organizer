<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <StackPanel Margin="{StaticResource DialogMargin}" Width="360">
            <StackPanel Classes="DialogField">
                <TextBlock Classes="DialogLabel" Text="Name"/>
                <TextBox Classes="DialogInput" Text="Discs"/>
                <TextBlock Classes="DialogError" Text="That name is taken."/>
            </StackPanel>
            <StackPanel Classes="DialogButtons" Margin="{StaticResource DialogButtonRowMargin}">
                <Button Classes="Dialog" Content="Cancel"/>
                <Button Classes="DialogPrimary" Content="Save"/>
            </StackPanel>
        </StackPanel>
    </Design.PreviewWith>

    <!-- The pieces every dialog is built from, so each one is spaced and sized the same -->

    <Style Selector="TextBlock.DialogLabel">
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="{StaticResource DialogTextFontSize}"/>
    </Style>

    <Style Selector="TextBlock.DialogTitle">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="{StaticResource DialogTitleFontSize}"/>
    </Style>

    <Style Selector="TextBlock.DialogSubject">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="{StaticResource DialogSubjectFontSize}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="TextBlock.DialogNote">
        <Setter Property="FontSize" Value="{StaticResource DialogTextFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Under its checkbox, lined up with the checkbox's caption rather than its box -->
    <Style Selector="TextBlock.OptionNote">
        <Setter Property="Margin" Value="{StaticResource OptionNoteMargin}"/>
    </Style>

    <Style Selector="TextBlock.DialogError">
        <Setter Property="FontSize" Value="{StaticResource DialogErrorFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- The folders the sidebar lists stand out from the folders inside them -->
    <Style Selector="TreeView.FolderChoices TextBlock.Listed">
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Pointed at and picked in the theme's own colours, as the sidebar's folders are, rather
         than in Fluent's accent -->
    <Style Selector="TreeView.FolderChoices TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
    </Style>
    <Style Selector="TreeView.FolderChoices TreeViewItem:selected /template/ Border#PART_LayoutRoot, TreeView.FolderChoices TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
    </Style>
    <Style Selector="TreeView.FolderChoices TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource SelectionForeground}"/>
    </Style>

    <Style Selector="TextBlock.ItemSubtitle">
        <Setter Property="FontSize" Value="{StaticResource ItemSubtitleFontSize}"/>
        <Setter Property="Opacity" Value="{StaticResource ItemSubtitleOpacity}"/>
    </Style>

    <Style Selector="HyperlinkButton.DialogLink">
        <Setter Property="FontSize" Value="{StaticResource DialogTextFontSize}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style Selector="TextBox.DialogInput">
        <Setter Property="Padding" Value="{StaticResource DialogTextBoxPadding}"/>
    </Style>

    <Style Selector="StackPanel.DialogField">
        <Setter Property="Spacing" Value="{StaticResource DialogFieldSpacing}"/>
    </Style>

    <Style Selector="StackPanel.DialogButtons">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Spacing" Value="{StaticResource DialogButtonSpacing}"/>
    </Style>

    <!-- Cancel and Close; the button Enter presses is DialogPrimary -->
    <Style Selector="Button.Dialog">
        <Setter Property="Padding" Value="{StaticResource DialogButtonPadding}"/>
    </Style>

    <Style Selector="Button.DialogPrimary">
        <Setter Property="Padding" Value="{StaticResource DialogButtonPadding}"/>
    </Style>

    <Style Selector="Button.DialogSmall">
        <Setter Property="Padding" Value="{StaticResource DialogSmallButtonPadding}"/>
    </Style>

    <!-- Beside the read-only box it fills in, so it matches the box's height -->
    <Style Selector="Button.DialogBrowse">
        <Setter Property="Padding" Value="{StaticResource DialogBrowseButtonPadding}"/>
        <Setter Property="Margin" Value="{StaticResource DialogBrowseButtonMargin}"/>
    </Style>

    <Style Selector="Button.CompareCopy">
        <Setter Property="Padding" Value="{StaticResource CompareCopyButtonPadding}"/>
    </Style>

    <Style Selector="PathIcon.DialogAlert">
        <Setter Property="Width" Value="{StaticResource DialogAlertIconSize}"/>
        <Setter Property="Height" Value="{StaticResource DialogAlertIconSize}"/>
        <Setter Property="Margin" Value="{StaticResource DialogAlertIconMargin}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <Style Selector="Border.IconChoices">
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource FrameThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource FrameCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource IconChoicesPadding}"/>
    </Style>

    <Style Selector="PathIcon.IconChoice">
        <Setter Property="Width" Value="{StaticResource IconChoiceSize}"/>
        <Setter Property="Height" Value="{StaticResource IconChoiceSize}"/>
    </Style>

    <Style Selector="Grid.DialogBody">
        <Setter Property="Margin" Value="{StaticResource DialogBodyMargin}"/>
    </Style>

    <Style Selector="Border.DialogFooter">
        <Setter Property="Padding" Value="{StaticResource DialogFooterPadding}"/>
    </Style>

    <!-- Only the Modern layout shows the preview, the heading and the swatches -->
    <Style Selector="Panel.AppearancePreview">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Width" Value="{StaticResource AppearancePreviewSize}"/>
        <Setter Property="Height" Value="{StaticResource AppearancePreviewSize}"/>
        <Setter Property="Margin" Value="{StaticResource AppearancePreviewMargin}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Panel.AppearancePreview Border.Tint">
        <Setter Property="CornerRadius" Value="{StaticResource AppearancePreviewCornerRadius}"/>
    </Style>
    <Style Selector="Panel.AppearancePreview PathIcon">
        <Setter Property="Width" Value="{StaticResource AppearancePreviewIconSize}"/>
        <Setter Property="Height" Value="{StaticResource AppearancePreviewIconSize}"/>
    </Style>

    <Style Selector="Border.AppearanceHeading">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize" Value="{StaticResource SectionTitleFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="{StaticResource SectionTitleLetterSpacing}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    </Style>

    <Style Selector="StackPanel.Swatches">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Orientation" Value="Horizontal"/>
    </Style>
    <Style Selector="StackPanel.Swatches StackPanel">
        <Setter Property="Spacing" Value="{StaticResource SwatchSpacing}"/>
    </Style>

    <!-- The ring says which swatch is chosen, so the list paints no selection of its own -->
    <Style Selector="StackPanel.Swatches ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="StackPanel.Swatches ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, StackPanel.Swatches ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, StackPanel.Swatches ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter, StackPanel.Swatches ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, StackPanel.Swatches ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Border.Swatch">
        <Setter Property="Width" Value="{StaticResource SwatchSize}"/>
        <Setter Property="Height" Value="{StaticResource SwatchSize}"/>
        <Setter Property="Padding" Value="{StaticResource SwatchPadding}"/>
        <Setter Property="BorderThickness" Value="{StaticResource SwatchRingThickness}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{StaticResource SwatchCornerRadius}"/>
    </Style>
    <Style Selector="Border.Swatch.Default">
        <Setter Property="Margin" Value="{StaticResource DefaultSwatchMargin}"/>
    </Style>
    <Style Selector="StackPanel.Swatches ListBoxItem:pointerover Border.Swatch, Button.CustomColor:pointerover Border.Swatch">
        <Setter Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}"/>
    </Style>
    <Style Selector="StackPanel.Swatches ListBoxItem:selected Border.Swatch, Button.CustomColor.Selected Border.Swatch">
        <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Line.DefaultMark">
        <Setter Property="StartPoint" Value="5,19"/>
        <Setter Property="EndPoint" Value="19,5"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="Stroke" Value="{DynamicResource DialogBackground}"/>
    </Style>

    <Style Selector="Button.CustomColor">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="{StaticResource CustomSwatchMargin}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.CustomColor:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.CustomColor:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- Every hue, for a colour of the user's own; filled in the middle once one is chosen -->
    <Style Selector="Ellipse.Spectrum">
        <Setter Property="Fill">
            <ConicGradientBrush>
                <GradientStop Offset="0" Color="#FF6B6B"/>
                <GradientStop Offset="0.17" Color="#F7C948"/>
                <GradientStop Offset="0.33" Color="#6BD88E"/>
                <GradientStop Offset="0.5" Color="#5EC8F0"/>
                <GradientStop Offset="0.67" Color="#9C8CFF"/>
                <GradientStop Offset="0.83" Color="#F07AC0"/>
                <GradientStop Offset="1" Color="#FF6B6B"/>
            </ConicGradientBrush>
        </Setter>
    </Style>
    <Style Selector="Ellipse.CustomFill">
        <Setter Property="Margin" Value="{StaticResource CustomSwatchFillMargin}"/>
    </Style>

    <!-- The Modern layout -->

    <!-- Filled in the accent through every state the template would otherwise paint grey, all
         but disabled -->
    <Style Selector="Window.Modern Button.DialogPrimary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Window.Modern Button.DialogPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        <Setter Property="Opacity" Value="{StaticResource AccentHoverOpacity}"/>
    </Style>
    <Style Selector="Window.Modern Button.DialogPrimary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        <Setter Property="Opacity" Value="{StaticResource AccentPressedOpacity}"/>
    </Style>

    <Style Selector="Window.Modern Border.IconChoices">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Every icon on a tile of one size, the chosen one ringed in the accent -->
    <Style Selector="Window.Modern Border.IconChoices WrapPanel">
        <Setter Property="ItemSpacing" Value="{StaticResource IconTileSpacing}"/>
        <Setter Property="LineSpacing" Value="{StaticResource IconTileSpacing}"/>
    </Style>
    <Style Selector="Window.Modern Border.IconChoices ListBoxItem">
        <Setter Property="Width" Value="{StaticResource IconTileSize}"/>
        <Setter Property="Height" Value="{StaticResource IconTileSize}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Window.Modern Border.IconChoices ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
        <Setter Property="BorderThickness" Value="{StaticResource IconTileBorderThickness}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Window.Modern Border.IconChoices ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, Window.Modern Border.IconChoices ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Window.Modern Border.IconChoices PathIcon.IconChoice">
        <Setter Property="Width" Value="{StaticResource IconTileIconSize}"/>
        <Setter Property="Height" Value="{StaticResource IconTileIconSize}"/>
    </Style>

    <Style Selector="Window.Modern Grid.DialogBody">
        <Setter Property="Margin" Value="{StaticResource ModernDialogBodyMargin}"/>
    </Style>

    <!-- The buttons in a band of their own, as Windows 11 ends a dialog -->
    <Style Selector="Window.Modern Border.DialogFooter">
        <Setter Property="Padding" Value="{StaticResource ModernDialogFooterPadding}"/>
        <Setter Property="Background" Value="{StaticResource DialogFooterBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>
    <Style Selector="Window.Modern Border.DialogFooter Button">
        <Setter Property="MinWidth" Value="{StaticResource DialogFooterButtonMinWidth}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Window.Modern Panel.AppearancePreview, Window.Modern Border.AppearanceHeading, Window.Modern StackPanel.Swatches">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Window.Modern Border.AppearanceHeading">
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="{StaticResource AppearanceHeadingPadding}"/>
    </Style>
    <!-- The swatches stand in for the drop-down, and the default swatch for the reset -->
    <Style Selector="Window.Modern ColorPicker.ClassicColor, Window.Modern Button.ResetColor">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="Border.DocumentFrame">
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource FrameThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource FrameCornerRadius}"/>
    </Style>

    <Style Selector="SelectableTextBlock.DocumentText">
        <Setter Property="FontFamily" Value="Consolas,Menlo,Monospace"/>
        <Setter Property="FontSize" Value="{StaticResource DocumentFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
</Styles>
