<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Design.PreviewWith>
        <Button ToolTip.Tip="New Database" Classes="LowEmphasis">
            <PathIcon Data="{StaticResource FilePlus}" Width="{StaticResource IconMedium}" Height="{StaticResource IconMedium}"/>
        </Button>
    </Design.PreviewWith>
    
    <Style Selector="ListBox.SidebarList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="ListBox.SidebarList ListBoxItem">
        <Setter Property="Padding" Value="35,8,10,8" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Style>

    <Style Selector="ListBox.SidebarList ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="ListBox.SidebarList ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>

    <Style Selector="TextBlock.SectionHeader">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <Setter Property="Margin" Value="15,10,10,5" />
    </Style>

    <Style Selector="ToggleButton.SidebarHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="15,10" />
    </Style>
    <Style Selector="ToggleButton.SidebarHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
    <Style Selector="ToggleButton.SidebarHeader:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
    </Style>
    <Style Selector="ToggleButton.SidebarHeader:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.SidebarHeader:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
    
    <!-- Left padding lines the chevron up with the search box above -->
    <Style Selector="ToggleButton.SidebarHeader.VirtualVolumeGroup">
        <Setter Property="Padding" Value="6,6,15,6" />
    </Style>

    <!-- Folders sit one step in from the volume holding them -->
    <Style Selector="ListBox.SidebarList.VirtualVolumeFolders ListBoxItem">
        <Setter Property="Padding" Value="26,8,10,8" />
    </Style>

    <!-- Sets the header's own actions apart from the ones acting on the database -->
    <Style Selector="Separator.SidebarHeaderSeparator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>

    <!-- Sets the toolbar apart from the volumes it acts on -->
    <Style Selector="Separator.SidebarToolbarRule">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>

    <Style Selector="Button.LowEmphasis">
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="Padding" Value="1"></Setter>
    </Style>
    
    <Style Selector="PathIcon.SidebarIcon">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        <Setter Property="Width" Value="{StaticResource IconMedium}"/>
        <Setter Property="Height" Value="{StaticResource IconMedium}"/>
    </Style>

    <Style Selector="PathIcon.SidebarChevron">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        <Setter Property="Width" Value="{StaticResource IconChevron}"/>
        <Setter Property="Height" Value="{StaticResource IconChevron}"/>
    </Style>

    <Style Selector="PathIcon.VolumeIcon">
        <Setter Property="Width" Value="{StaticResource IconVolume}"/>
        <Setter Property="Height" Value="{StaticResource IconVolume}"/>
    </Style>

    <!-- Details are hidden by default and revealed on hover or selection; the setting turns
         them on for good. Never set IsVisible on these locally or the styles stop winning. -->
    <Style Selector="ListBox.VirtualVolumeFolders TextBlock.FolderDetail">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="FontSize" Value="{StaticResource SidebarItemSubtitleFontSize}"/>
        <Setter Property="Opacity" Value="{StaticResource SidebarItemSubtitleOpacity}"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="ListBox.VirtualVolumeFolders ListBoxItem:pointerover TextBlock.FolderDetail">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="ListBox.VirtualVolumeFolders ListBoxItem:selected TextBlock.FolderDetail">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="ListBox.VirtualVolumeFolders.AlwaysDetails TextBlock.FolderDetail">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- A folder waiting to be moved recedes until it is pasted or the paste is called off -->
    <Style Selector="Grid.Cut">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="PathIcon.FlipY">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="-1" />
            </Setter.Value>
        </Setter>
    </Style>
</Styles>

