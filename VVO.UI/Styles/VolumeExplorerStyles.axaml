<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:VVO.UI.Views"
        xmlns:vm="using:VVO.UI.ViewModels">

    <Design.PreviewWith>
        <TextBox Classes="SearchBox" PlaceholderText="Search all..." />
    </Design.PreviewWith>
    
    <!-- The Modern layout shows it in the status bar -->
    <Style Selector="Window.Modern TextBlock.HeaderSummary">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="DataGrid.ExplorerGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="SeparatorBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style Selector="DataGridRow:selected">
        <Setter Property="Background" Value="{DynamicResource RowSelectionBackground}" />
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style Selector="Border.PathViewStyle, TextBox.SearchBox">
        <Setter Property="Border.BorderThickness" Value="{StaticResource FieldBorderThickness}"/>
        <Setter Property="Border.Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="Border.BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="Border.CornerRadius" Value="{StaticResource FieldCornerRadius}"/>
    </Style>

    <!-- Fluent repaints the frame on hover and focus; it keeps the Path box's, and focus only
         takes the accent colour -->
    <Style Selector="TextBox.SearchBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
    </Style>
    <Style Selector="TextBox.SearchBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="BorderThickness" Value="{StaticResource FieldBorderThickness}"/>
    </Style>

    <Style Selector="TextBox.SearchBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="InnerLeftContent">
            <Setter.Value>
                <Template>
                    <PathIcon Data="{StaticResource MagnifyingGlassLight}" 
                              Width="{StaticResource IconMedium}" 
                              Height="{StaticResource IconMedium}"
                              Margin="8, 0,0,0"
                              VerticalAlignment="Center"/>
                </Template>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.PathViewStyle">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="8, 0" />
    </Style>

    <Style Selector="Border.PathViewStyle Button.PathUp">
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style Selector="Border.PathViewStyle Button.Breadcrumb">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- One long folder name can no longer swallow the whole bar -->
        <Setter Property="MaxWidth" Value="180"/>
    </Style>

    <Style Selector="Border.PathViewStyle TextBlock.VolumePrefix">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style Selector="Border.PathViewStyle TextBlock.BreadcrumbSeparator">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- A tint of whatever colour its parent stands in; only the Modern layout shows one -->
    <Style Selector="Border.Tint">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Opacity" Value="{StaticResource TintOpacity}"/>
    </Style>
    <Style Selector="Window.Modern Border.Tint">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="StackPanel.VolumeChip">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="{StaticResource VolumeChipSpacing}"/>
    </Style>
    <Style Selector="PathIcon.VolumeChip">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Width" Value="{StaticResource VolumeChipIconSize}"/>
        <Setter Property="Height" Value="{StaticResource VolumeChipIconSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Window.Modern views|VolumeExplorerView">
        <Setter Property="BorderBrush" Value="{DynamicResource ContentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource PanelBorderThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}"/>
    </Style>
    <Style Selector="Window.Modern Panel.VolumeChip">
        <Setter Property="Margin" Value="{StaticResource VolumeChipMargin}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Window.Modern Panel.VolumeChip > Border.Tint">
        <Setter Property="CornerRadius" Value="{StaticResource TagCornerRadius}"/>
    </Style>
    <Style Selector="Window.Modern StackPanel.VolumeChip">
        <Setter Property="Margin" Value="{StaticResource VolumeChipPadding}"/>
    </Style>
    <Style Selector="Window.Modern PathIcon.VolumeChip">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Window.Modern Border.PathViewStyle TextBlock.VolumePrefix" x:DataType="vm:VolumeExplorerViewModel">
        <Setter Property="Foreground" Value="{Binding VolumeIconBrush}"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style Selector="Panel.ExtensionTag > TextBlock">
        <Setter Property="Margin" Value="{StaticResource CellTextMargin}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Window.Modern Panel.ExtensionTag">
        <Setter Property="Margin" Value="{StaticResource CellTextMargin}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Window.Modern Panel.ExtensionTag > Border.Tint">
        <Setter Property="CornerRadius" Value="{StaticResource TagCornerRadius}"/>
    </Style>
    <Style Selector="Window.Modern Panel.ExtensionTag > TextBlock">
        <Setter Property="Margin" Value="{StaticResource ExtensionTagPadding}"/>
        <Setter Property="FontSize" Value="{StaticResource ExtensionTagFontSize}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style Selector="Window.Modern DataGridCell TextBlock.Folder">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Window.Modern DataGridCell.Number TextBlock">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="FontFeatures" Value="+tnum"/>
    </Style>
    <Style Selector="Window.Modern DataGridRow:selected">
        <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
    </Style>
    
</Styles>

