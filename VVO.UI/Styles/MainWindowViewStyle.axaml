<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:VVO.UI"
        xmlns:vm="using:VVO.UI.ViewModels">
    <Design.PreviewWith>
    <Border Padding="20">
      <Menu Grid.Row="0" Classes="MenuBarStyle">
            <MenuItem Header="_File">
                <MenuItem Header="_Scan D:\ Volume..."  />
                <Separator/>
                <MenuItem Header="_Exit" />
            </MenuItem>
            <MenuItem Header="_View" />
            <MenuItem Header="_Tools" />
            <MenuItem Header="_Settings" />
            <MenuItem Header="_About" />
        </Menu>
    </Border>
    </Design.PreviewWith>
    
    <!-- Every window asks for Mica under a Mica theme -->
    <Style Selector="Window">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TransparencyLevelHint"
                Value="{Binding $self.ActualThemeVariant, Converter={x:Static local:Theme.TransparencyFor}}"/>
    </Style>

    <!-- Painted solid where no backdrop is drawn; TransparencyBackgroundFallback is not refreshed
         once a window is open -->
    <Style Selector="Window.AppWindow">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
    </Style>
    <Style Selector="Window.AppWindow.Opaque">
        <Setter Property="Background" Value="{DynamicResource WindowFallbackBackground}"/>
    </Style>

    <!-- The Modern layout draws the menu row as the title bar, beside the system caption buttons -->
    <Style Selector="Window.Modern.MenuInTitleBar">
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="True"/>
        <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="{StaticResource TitleBarHeight}"/>
    </Style>
    <Style Selector="Window.Modern Grid.MenuBar">
        <Setter Property="Height" Value="{StaticResource TitleBarHeight}"/>
    </Style>
    <Style Selector="Image.TitleBarIcon">
        <Setter Property="IsVisible" Value="False"/>
        <Setter Property="Width" Value="{StaticResource IconMedium}"/>
        <Setter Property="Height" Value="{StaticResource IconMedium}"/>
        <Setter Property="Margin" Value="{StaticResource TitleBarIconMargin}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Window.Modern Image.TitleBarIcon">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <!-- The platform moves, maximises and snaps the window from here; the role only takes effect
         while the window is extended into its title bar -->
    <Style Selector="Border.TitleBarDrag">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="WindowDecorationProperties.ElementRole" Value="TitleBar"/>
    </Style>

    <Style Selector="StackPanel.StatusMessage">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="{StaticResource StatusSpacing}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Fixed width: a count that grows a digit would otherwise reflow the row and shift what
         sits beside it -->
    <Style Selector="TextBlock.StatusMessage">
        <Setter Property="MinWidth" Value="{StaticResource StatusMessageMinWidth}"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="{StaticResource StatusItemMargin}"/>
    </Style>
    <Style Selector="PathIcon.DatabaseStatus">
        <Setter Property="Width" Value="{StaticResource IconMedium}"/>
        <Setter Property="Height" Value="{StaticResource IconMedium}"/>
        <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="{StaticResource DatabaseStatusMargin}"/>
    </Style>

    <Style Selector="Border.StatusBar, TextBlock.StatusSummary">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Window.Modern Border.StatusBar" x:DataType="vm:MainWindowViewModel">
        <Setter Property="IsVisible" Value="{Binding !IsStartPageVisible}"/>
        <Setter Property="Height" Value="{StaticResource StatusBarHeight}"/>
        <Setter Property="Background" Value="{DynamicResource StatusBarBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ContentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>
    <Style Selector="Window.Modern TextBlock.StatusSummary" x:DataType="vm:MainWindowViewModel">
        <Setter Property="IsVisible" Value="{Binding !IsStartPageVisible}"/>
        <Setter Property="FontSize" Value="{StaticResource StatusBarFontSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="{StaticResource StatusBarStartMargin}"/>
    </Style>
    <Style Selector="Window.Modern StackPanel.StatusMessage">
        <Setter Property="Grid.Row" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="{StaticResource StatusBarStartMargin}"/>
    </Style>
    <Style Selector="Window.Modern TextBlock.StatusMessage">
        <Setter Property="FontSize" Value="{StaticResource StatusBarFontSize}"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>
    <Style Selector="Window.Modern PathIcon.DatabaseStatus">
        <Setter Property="Grid.Row" Value="2"/>
        <Setter Property="Margin" Value="{StaticResource StatusBarEndMargin}"/>
    </Style>

    <Style Selector="Menu.MenuBarStyle">
      <Setter Property="Background" Value="{DynamicResource ChromeBackground}" />
    </Style>
    <Style Selector="Menu.MenuBarStyle > MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- Invisible until the pointer lands on it. MinWidth has to be set as well as Width: the
         Fluent theme floors a GridSplitter at 6, and a floor outranks a width. -->
    <Style Selector="GridSplitter.PaneSplitter">
      <Setter Property="MinWidth" Value="{StaticResource PaneSplitterWidth}" />
      <Setter Property="Width" Value="{StaticResource PaneSplitterWidth}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Window.Modern GridSplitter.PaneSplitter:pointerover, Window.Modern GridSplitter.PaneSplitter:pressed">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
</Styles>

