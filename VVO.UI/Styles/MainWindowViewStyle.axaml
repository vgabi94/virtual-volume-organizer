<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:VVO.UI">
    <Design.PreviewWith>
    <Border Padding="20">
      <Menu Grid.Row="0" Classes="MenuBarStyle">
            <MenuItem Header="_File">
                <MenuItem Header="_Scan D:\ Volume..."  />
                <Separator/>
                <MenuItem Header="_Exit" />
            </MenuItem>
            <MenuItem Header="_View" />
            <MenuItem Header="_Tools" />
            <MenuItem Header="_Settings" />
            <MenuItem Header="_About" />
        </Menu>
    </Border>
    </Design.PreviewWith>
    
    <!-- Every window asks for Mica under a Mica theme -->
    <Style Selector="Window">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TransparencyLevelHint"
                Value="{Binding $self.ActualThemeVariant, Converter={x:Static local:Theme.TransparencyFor}}"/>
    </Style>

    <!-- Painted solid where no backdrop is drawn; TransparencyBackgroundFallback is not refreshed
         once a window is open -->
    <Style Selector="Window.AppWindow">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
    </Style>
    <Style Selector="Window.AppWindow.Opaque">
        <Setter Property="Background" Value="{DynamicResource WindowFallbackBackground}"/>
    </Style>

    <Style Selector="Menu.MenuBarStyle">
      <Setter Property="Background" Value="{DynamicResource ChromeBackground}" />
    </Style>
    <Style Selector="Menu.MenuBarStyle > MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- Invisible until the pointer lands on it. MinWidth has to be set as well as Width: the
         Fluent theme floors a GridSplitter at 6, and a floor outranks a width. -->
    <Style Selector="GridSplitter.PaneSplitter">
      <Setter Property="MinWidth" Value="4" />
      <Setter Property="Width" Value="4" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
</Styles>

