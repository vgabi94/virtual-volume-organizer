<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:VVO.UI">

    <!-- The colours the application picks for itself. Everything else is the Fluent palette,
         which already carries a value for each variant. -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <!-- Set apart from the panel behind it, which the theme's own value is not -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#1C1C1C"/>

            <!-- Level with the menu bar, so a dialog reads as part of the application rather
                 than as a hole cut in it -->
            <SolidColorBrush x:Key="DialogBackground" Color="#1F1F1F"/>

            <!-- Each surface, text weight and state by what it is for. The plain themes give each
                 the Fluent colour it was drawn in before it had a name, so a theme that changes one
                 role leaves the others where they were. -->
            <SolidColorBrush x:Key="WindowBackground" Color="#000000"/>
            <SolidColorBrush x:Key="ChromeBackground" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="SidebarBackground" Color="#2B2B2B"/>
            <SolidColorBrush x:Key="StartPageBackground" Color="#2B2B2B"/>
            <!-- Stated rather than laid over the window as a wash of white, which left the
                 listing taking its colour from whatever happened to be behind it -->
            <SolidColorBrush x:Key="ContentBackground" Color="#181818"/>
            <SolidColorBrush x:Key="ContentBorderBrush" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="StatusBarBackground" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="IconBrush" Color="#99FFFFFF"/>
            <SolidColorBrush x:Key="HoverBackground" Color="#19FFFFFF"/>
            <SolidColorBrush x:Key="PressedBackground" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="SelectionBackground" Color="#0078D7" Opacity="0.6"/>
            <SolidColorBrush x:Key="SelectionForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="RowSelectionBackground" Color="#19FFFFFF"/>
            <SolidColorBrush x:Key="ControlBackground" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#99FFFFFF"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#F85149"/>
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFF000"/>

            <!-- Every kind of file in the plain icon colour. A theme that colours them by kind
                 names its own brush for each; one it leaves out is drawn as here. -->
            <StaticResource x:Key="FolderSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileImageSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileAudioSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileVideoSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileZipperSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FilePdfSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileWordSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileExcelSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileCsvSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FilePowerpointSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileLinesSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileCodeSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileCogBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileEarmarkBinaryFillBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="CompactDiscSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="DatabaseSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileSolidBrush" ResourceKey="IconBrush"/>

            <!-- Diff row tints, following the green/red a git diff uses on a dark background -->
            <SolidColorBrush x:Key="DiffAddedBackground" Color="#12261E"/>
            <SolidColorBrush x:Key="DiffAddedSelectedBackground" Color="#1D4430"/>
            <SolidColorBrush x:Key="DiffAddedForeground" Color="#3FB950"/>
            <SolidColorBrush x:Key="DiffRemovedBackground" Color="#25171C"/>
            <SolidColorBrush x:Key="DiffRemovedSelectedBackground" Color="#4A2029"/>
            <SolidColorBrush x:Key="DiffRemovedForeground" Color="#F85149"/>
            <SolidColorBrush x:Key="DiffChangedBackground" Color="#221B10"/>
            <SolidColorBrush x:Key="DiffChangedSelectedBackground" Color="#40331C"/>
            <SolidColorBrush x:Key="DiffChangedForeground" Color="#D29922"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DialogBackground" Color="#FAF9F7"/>

            <SolidColorBrush x:Key="WindowBackground" Color="#FAF9F7"/>
            <SolidColorBrush x:Key="ChromeBackground" Color="#EDEBE7"/>
            <SolidColorBrush x:Key="SidebarBackground" Color="#F2F0EC"/>
            <SolidColorBrush x:Key="StartPageBackground" Color="#F2F0EC"/>
            <SolidColorBrush x:Key="ContentBackground" Color="#FFFDFB"/>
            <SolidColorBrush x:Key="ContentBorderBrush" Color="#CBC6BE"/>
            <SolidColorBrush x:Key="StatusBarBackground" Color="#EDEBE7"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#CBC6BE"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#22201D"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6A655D"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#CBC6BE"/>
            <SolidColorBrush x:Key="IconBrush" Color="#6A655D"/>
            <SolidColorBrush x:Key="HoverBackground" Color="#14000000"/>
            <SolidColorBrush x:Key="PressedBackground" Color="#28000000"/>
            <SolidColorBrush x:Key="SelectionBackground" Color="#0078D7" Opacity="0.4"/>
            <SolidColorBrush x:Key="SelectionForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="RowSelectionBackground" Color="#14000000"/>
            <SolidColorBrush x:Key="ControlBackground" Color="#EDEBE7"/>
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#C9C3BA"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#C0362C"/>
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#C50500"/>

            <StaticResource x:Key="FolderSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileImageSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileAudioSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileVideoSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileZipperSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FilePdfSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileWordSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileExcelSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileCsvSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FilePowerpointSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileLinesSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileCodeSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileCogBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileEarmarkBinaryFillBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="CompactDiscSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="DatabaseSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileSolidBrush" ResourceKey="IconBrush"/>

            <!-- The shade that carries secondary text is too heavy for an edge on paper -->
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#C9C3BA"/>

            <!-- The same tints held to the paper ground: enough colour to tell the three apart
                 at a glance, little enough that a screenful of them is still restful -->
            <SolidColorBrush x:Key="DiffAddedBackground" Color="#E9F5EC"/>
            <SolidColorBrush x:Key="DiffAddedSelectedBackground" Color="#CFE7D6"/>
            <SolidColorBrush x:Key="DiffAddedForeground" Color="#1A7F37"/>
            <SolidColorBrush x:Key="DiffRemovedBackground" Color="#FBEBEA"/>
            <SolidColorBrush x:Key="DiffRemovedSelectedBackground" Color="#F6D4D1"/>
            <SolidColorBrush x:Key="DiffRemovedForeground" Color="#C0362C"/>
            <SolidColorBrush x:Key="DiffChangedBackground" Color="#FBF3DE"/>
            <SolidColorBrush x:Key="DiffChangedSelectedBackground" Color="#F1E3BC"/>
            <SolidColorBrush x:Key="DiffChangedForeground" Color="#8A6116"/>
        </ResourceDictionary>

        <!-- Drawn over the Mica backdrop: the frame, sidebar and bars let the wallpaper's tint
             through, and the content sits on one translucent raised layer. Whatever is not named
             here is the plain theme's. -->
        <ResourceDictionary x:Key="{x:Static local:Theme.MicaDark}">
            <SolidColorBrush x:Key="WindowBackground" Color="#00000000"/>
            <!-- Painted instead when the system draws no Mica: Windows 10, or a remote session -->
            <SolidColorBrush x:Key="WindowFallbackBackground" Color="#202227"/>
            <SolidColorBrush x:Key="ChromeBackground" Color="#00000000"/>
            <SolidColorBrush x:Key="SidebarBackground" Color="#00000000"/>
            <SolidColorBrush x:Key="StartPageBackground" Color="#00000000"/>
            <SolidColorBrush x:Key="StatusBarBackground" Color="#00000000"/>
            <SolidColorBrush x:Key="ContentBackground" Color="#D127282C"/>
            <SolidColorBrush x:Key="ContentBorderBrush" Color="#1CFFFFFF"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#12FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C7FFFFFF"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#80FFFFFF"/>
            <SolidColorBrush x:Key="IconBrush" Color="#C7FFFFFF"/>
            <SolidColorBrush x:Key="HoverBackground" Color="#0EFFFFFF"/>
            <SolidColorBrush x:Key="PressedBackground" Color="#1FFFFFFF"/>
            <!-- A tint rather than the accent, so a selection reads as quiet as the rest -->
            <SolidColorBrush x:Key="SelectionBackground" Color="#16FFFFFF"/>
            <SolidColorBrush x:Key="RowSelectionBackground" Color="#16FFFFFF"/>
            <!-- Fluent draws a selected list item from these, the accent at three strengths -->
            <StaticResource x:Key="SystemControlHighlightListAccentLowBrush" ResourceKey="SelectionBackground"/>
            <StaticResource x:Key="SystemControlHighlightListAccentMediumBrush" ResourceKey="PressedBackground"/>
            <StaticResource x:Key="SystemControlHighlightListAccentHighBrush" ResourceKey="PressedBackground"/>
            <SolidColorBrush x:Key="ControlBackground" Color="#0EFFFFFF"/>
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#00253A"/>
            <SolidColorBrush x:Key="DialogBackground" Color="#2B2C30"/>

            <SolidColorBrush x:Key="FolderSolidBrush" Color="#FFC83D"/>
            <SolidColorBrush x:Key="FileImageSolidBrush" Color="#EE97C9"/>
            <StaticResource x:Key="FileAudioSolidBrush" ResourceKey="IconBrush"/>
            <SolidColorBrush x:Key="FileVideoSolidBrush" Color="#C3A5F9"/>
            <SolidColorBrush x:Key="FileZipperSolidBrush" Color="#EFA464"/>
            <SolidColorBrush x:Key="FilePdfSolidBrush" Color="#61C3F9"/>
            <SolidColorBrush x:Key="FileWordSolidBrush" Color="#61C3F9"/>
            <SolidColorBrush x:Key="FileExcelSolidBrush" Color="#61C3F9"/>
            <SolidColorBrush x:Key="FileCsvSolidBrush" Color="#61C3F9"/>
            <SolidColorBrush x:Key="FilePowerpointSolidBrush" Color="#61C3F9"/>
            <SolidColorBrush x:Key="FileLinesSolidBrush" Color="#61C3F9"/>
            <SolidColorBrush x:Key="FileCodeSolidBrush" Color="#73CE95"/>
            <StaticResource x:Key="FileCogBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileEarmarkBinaryFillBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="CompactDiscSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="DatabaseSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileSolidBrush" ResourceKey="IconBrush"/>
        </ResourceDictionary>

        <!-- Drawn over the Mica backdrop: the frame, sidebar and bars let the wallpaper's tint
             through, and the content sits on one translucent raised layer. Whatever is not named
             here is the plain theme's. -->
        <ResourceDictionary x:Key="{x:Static local:Theme.MicaLight}">
            <SolidColorBrush x:Key="WindowBackground" Color="#00000000"/>
            <!-- Painted instead when the system draws no Mica: Windows 10, or a remote session -->
            <SolidColorBrush x:Key="WindowFallbackBackground" Color="#F3F4F7"/>
            <SolidColorBrush x:Key="ChromeBackground" Color="#00000000"/>
            <SolidColorBrush x:Key="SidebarBackground" Color="#00000000"/>
            <SolidColorBrush x:Key="StartPageBackground" Color="#00000000"/>
            <SolidColorBrush x:Key="StatusBarBackground" Color="#00000000"/>
            <SolidColorBrush x:Key="ContentBackground" Color="#C7FFFFFF"/>
            <SolidColorBrush x:Key="ContentBorderBrush" Color="#1A000000"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#11000000"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3000000"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#75000000"/>
            <SolidColorBrush x:Key="IconBrush" Color="#B3000000"/>
            <SolidColorBrush x:Key="HoverBackground" Color="#0A000000"/>
            <SolidColorBrush x:Key="PressedBackground" Color="#14000000"/>
            <!-- A tint rather than the accent, so a selection reads as quiet as the rest -->
            <SolidColorBrush x:Key="SelectionBackground" Color="#0E000000"/>
            <SolidColorBrush x:Key="SelectionForeground" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="RowSelectionBackground" Color="#0E000000"/>
            <!-- Fluent draws a selected list item from these, the accent at three strengths -->
            <StaticResource x:Key="SystemControlHighlightListAccentLowBrush" ResourceKey="SelectionBackground"/>
            <StaticResource x:Key="SystemControlHighlightListAccentMediumBrush" ResourceKey="PressedBackground"/>
            <StaticResource x:Key="SystemControlHighlightListAccentHighBrush" ResourceKey="PressedBackground"/>
            <SolidColorBrush x:Key="ControlBackground" Color="#BFFFFFFF"/>
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#1A000000"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#005FB8"/>
            <SolidColorBrush x:Key="DialogBackground" Color="#FAFAFA"/>

            <SolidColorBrush x:Key="FolderSolidBrush" Color="#E9A400"/>
            <SolidColorBrush x:Key="FileImageSolidBrush" Color="#AF4A88"/>
            <StaticResource x:Key="FileAudioSolidBrush" ResourceKey="IconBrush"/>
            <SolidColorBrush x:Key="FileVideoSolidBrush" Color="#835CBE"/>
            <SolidColorBrush x:Key="FileZipperSolidBrush" Color="#B25900"/>
            <SolidColorBrush x:Key="FilePdfSolidBrush" Color="#007FBF"/>
            <SolidColorBrush x:Key="FileWordSolidBrush" Color="#007FBF"/>
            <SolidColorBrush x:Key="FileExcelSolidBrush" Color="#007FBF"/>
            <SolidColorBrush x:Key="FileCsvSolidBrush" Color="#007FBF"/>
            <SolidColorBrush x:Key="FilePowerpointSolidBrush" Color="#007FBF"/>
            <SolidColorBrush x:Key="FileLinesSolidBrush" Color="#007FBF"/>
            <SolidColorBrush x:Key="FileCodeSolidBrush" Color="#008D4B"/>
            <StaticResource x:Key="FileCogBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileEarmarkBinaryFillBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="CompactDiscSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="DatabaseSolidBrush" ResourceKey="IconBrush"/>
            <StaticResource x:Key="FileSolidBrush" ResourceKey="IconBrush"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
