<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        xmlns:views="using:VVO.UI.Views"
        x:Class="VVO.UI.Views.VirtualVolumeDialogView"
        x:DataType="vm:VirtualVolumeDialogViewModel"
        Title="{Binding Header}" Width="460"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackground}">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Height" Value="470"/>
        </Style>
        <Style Selector="Window.Modern">
            <Setter Property="Height" Value="NaN"/>
            <Setter Property="SizeToContent" Value="Height"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="DialogFooter">
            <StackPanel Classes="DialogButtons">
                <Button Content="Cancel"
                        Click="OnCancelClicked"
                        IsCancel="True"
                        Classes="Dialog"/>
                <Button Content="{Binding ConfirmText}"
                        Click="OnConfirmClicked"
                        IsDefault="True"
                        IsEnabled="{Binding CanConfirm}"
                        Classes="DialogPrimary"/>
            </StackPanel>
        </Border>

        <Grid RowDefinitions="Auto, *" Classes="DialogBody" RowSpacing="{StaticResource DialogRowSpacing}">

            <DockPanel Grid.Row="0">
                <Panel DockPanel.Dock="Left" Classes="AppearancePreview">
                    <Border Classes="Tint" Background="{Binding SelectedBrush}"/>
                    <PathIcon Data="{Binding SelectedIcon.Data}"
                              Classes.FlipY="{Binding SelectedIcon.IsFlipped}"
                              Foreground="{Binding SelectedBrush}"/>
                </Panel>
                <StackPanel Classes="DialogField">
                    <TextBlock Text="Name" Classes="DialogLabel"/>
                    <TextBox Text="{Binding VolumeName, Mode=TwoWay}"
                             PlaceholderText="e.g. Backup Drives"
                             Classes="DialogInput"/>
                    <TextBlock Text="{Binding NameProblem}"
                               IsVisible="{Binding NameProblem, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Classes="DialogError"/>
                </StackPanel>
            </DockPanel>

            <views:AppearanceChoices Grid.Row="1"/>
        </Grid>
    </DockPanel>
</Window>
