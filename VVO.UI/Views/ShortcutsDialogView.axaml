<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.ShortcutsDialogView"
        x:DataType="vm:ShortcutsDialogViewModel"
        Title="Keyboard Shortcuts" Width="400" Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackground}">

    <Grid RowDefinitions="*, Auto" Margin="{StaticResource DialogMargin}">
        <ItemsControl Grid.Row="0" ItemsSource="{Binding Shortcuts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ShortcutRow">
                    <Grid ColumnDefinitions="120, *" Margin="{StaticResource ShortcutRowMargin}">
                        <TextBlock Grid.Column="0" Text="{Binding Gesture}" FontWeight="Bold" FontSize="{StaticResource DialogTextFontSize}"/>
                        <TextBlock Grid.Column="1" Classes="DialogNote" Text="{Binding Action}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="1"
                Content="Close"
                Click="OnCloseClicked"
                IsDefault="True"
                IsCancel="True"
                HorizontalAlignment="Right"
                Margin="{StaticResource DialogSectionMargin}"
                Classes="Dialog"/>
    </Grid>
</Window>
