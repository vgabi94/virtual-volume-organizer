<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.OptionsDialogView"
        x:DataType="vm:OptionsDialogViewModel"
        Title="Options" Width="440" Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackground}">

    <Grid RowDefinitions="*, Auto" Margin="{StaticResource DialogMargin}">
        <StackPanel Grid.Row="0" Spacing="{StaticResource OptionsSpacing}">
            <StackPanel Spacing="{StaticResource DialogNoteSpacing}">
                <CheckBox Content="Dark theme"
                          IsChecked="{Binding DarkTheme, Mode=TwoWay}"/>
                <TextBlock Classes="DialogNote OptionNote" Text="When off the application wears its light theme instead."/>
            </StackPanel>

            <CheckBox Content="Slate theme"
                      IsChecked="{Binding SlateTheme, Mode=TwoWay}"/>

            <CheckBox Content="Modern layout"
                      IsChecked="{Binding ModernLayout, Mode=TwoWay}"/>

            <StackPanel Spacing="{StaticResource DialogNoteSpacing}">
                <CheckBox Content="Always show folder paths and descriptions"
                          IsChecked="{Binding ShowFolderDetailsAlways, Mode=TwoWay}"/>
                <TextBlock Classes="DialogNote OptionNote" Text="When off they appear only while a folder is hovered or selected."/>
            </StackPanel>

            <StackPanel Spacing="{StaticResource DialogNoteSpacing}">
                <CheckBox Content="Scan hidden and system files"
                          IsChecked="{Binding ScanHiddenAndSystem, Mode=TwoWay}"/>
                <TextBlock Classes="DialogNote OptionNote" Text="When off, a scan leaves out anything marked hidden or system, which on a system drive means ProgramData and every AppData folder."/>
            </StackPanel>

            <StackPanel Classes="DialogField">
                <TextBlock Text="Databases to remember on the start page"/>
                <NumericUpDown Value="{Binding MaxRecentDatabases, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="30"
                               Increment="1"
                               FormatString="0"
                               Width="{StaticResource OptionsNumberWidth}"
                               HorizontalAlignment="Left"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Classes="DialogButtons" Margin="{StaticResource DialogButtonRowMargin}">
            <Button Content="Cancel" Click="OnCancelClicked" IsCancel="True" Classes="Dialog"/>
            <Button Content="Save" Click="OnSaveClicked" IsDefault="True" Classes="DialogPrimary"/>
        </StackPanel>
    </Grid>
</Window>
