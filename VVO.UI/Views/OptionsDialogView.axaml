<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.OptionsDialogView"
        x:DataType="vm:OptionsDialogViewModel"
        Title="Options" Width="440" Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource SystemRegionColor}">

    <Grid RowDefinitions="*, Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="18">
            <StackPanel Spacing="4">
                <CheckBox Content="Always show folder paths and descriptions"
                          IsChecked="{Binding ShowFolderDetailsAlways, Mode=TwoWay}"/>
                <TextBlock Text="When off they appear only while a folder is hovered or selected."
                           TextWrapping="Wrap"
                           FontSize="13"
                           Margin="28,0,0,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <CheckBox Content="Scan hidden and system files"
                          IsChecked="{Binding ScanHiddenAndSystem, Mode=TwoWay}"/>
                <TextBlock Text="When off, a scan leaves out anything marked hidden or system, which on a system drive means ProgramData and every AppData folder."
                           TextWrapping="Wrap"
                           FontSize="13"
                           Margin="28,0,0,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Databases to remember on the start page"/>
                <NumericUpDown Value="{Binding MaxRecentDatabases, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="30"
                               Increment="1"
                               FormatString="0"
                               Width="140"
                               HorizontalAlignment="Left"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Content="Cancel" Click="OnCancelClicked" IsCancel="True" Padding="18,7"/>
            <Button Content="Save" Click="OnSaveClicked" IsDefault="True" Padding="18,7"/>
        </StackPanel>
    </Grid>
</Window>
