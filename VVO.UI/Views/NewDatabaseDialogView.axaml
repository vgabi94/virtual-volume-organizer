<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.NewDatabaseDialogView"
        x:DataType="vm:NewDatabaseDialogViewModel"
        Title="New Database" Width="480" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        x:Name="DialogWindow"
        Background="{DynamicResource DialogBackground}">

    <Grid RowDefinitions="Auto, *, Auto" Margin="{StaticResource DialogMargin}">
        <StackPanel Grid.Row="1" Spacing="{StaticResource DialogSectionSpacing}">
            <StackPanel Classes="DialogField">
                <TextBlock Text="Database Name" Classes="DialogLabel"/>
                <TextBox Text="{Binding CustomName, Mode=TwoWay}" 
                         PlaceholderText="e.g. My Media Collection" 
                         Classes="DialogInput"/>
            </StackPanel>

            <StackPanel Classes="DialogField">
                <TextBlock Text="Save Location" Classes="DialogLabel"/>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" 
                             Text="{Binding DatabasePath, Mode=TwoWay}" 
                             PlaceholderText="Click Browse to choose path..." 
                             IsReadOnly="True" 
                             Classes="DialogInput"/>
                    <Button Grid.Column="1" 
                            Content="Browse..." 
                            Classes="DialogBrowse"
                            Command="{Binding SelectPathCommand}" 
                            CommandParameter="{Binding #DialogWindow}"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Classes="DialogButtons" Margin="{StaticResource DialogButtonRowMargin}">
            <Button Content="Cancel" 
                    Click="OnCancelClicked" 
                    IsCancel="True" 
                    Classes="Dialog"/>
            <Button Content="Create" 
                    Click="OnCreateClicked" 
                    IsDefault="True" 
                    IsEnabled="{Binding CanCreate}" 
                    Classes="DialogPrimary"/>
        </StackPanel>
    </Grid>
</Window>
