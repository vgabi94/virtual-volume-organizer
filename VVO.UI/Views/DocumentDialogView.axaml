<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.DocumentDialogView"
        x:DataType="vm:DocumentDialogViewModel"
        Title="{Binding Title}" Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackground}">

    <Grid RowDefinitions="*, Auto" Margin="{StaticResource DialogMargin}" RowSpacing="{StaticResource DialogRowSpacing}">

        <Border Grid.Row="0" Classes="DocumentFrame">
            <ScrollViewer Padding="{StaticResource DocumentPadding}" HorizontalScrollBarVisibility="Auto">
                <SelectableTextBlock Classes="DocumentText" Text="{Binding Text}"/>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="1"
                Content="Close"
                Click="OnCloseClicked"
                IsDefault="True"
                IsCancel="True"
                HorizontalAlignment="Right"
                Classes="Dialog"/>
    </Grid>
</Window>
