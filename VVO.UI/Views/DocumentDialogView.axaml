<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.DocumentDialogView"
        x:DataType="vm:DocumentDialogViewModel"
        Title="{Binding Title}" Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackground}">

    <Grid RowDefinitions="*, Auto" Margin="24" RowSpacing="14">

        <Border Grid.Row="0"
                BorderThickness="1"
                CornerRadius="4"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <ScrollViewer Padding="14" HorizontalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding Text}"
                                     FontFamily="Consolas,Menlo,Monospace"
                                     FontSize="12"
                                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="1"
                Content="Close"
                Click="OnCloseClicked"
                IsDefault="True"
                IsCancel="True"
                HorizontalAlignment="Right"
                Padding="18,7"/>
    </Grid>
</Window>
