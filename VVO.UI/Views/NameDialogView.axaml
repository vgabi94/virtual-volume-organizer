<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.NameDialogView"
        x:DataType="vm:NameDialogViewModel"
        Title="Name" Width="420" Height="190"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource SystemRegionColor}">

    <Grid RowDefinitions="*, Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding Header}" FontWeight="Medium" FontSize="13"/>
            <TextBox Text="{Binding Name, Mode=TwoWay}" Padding="10,8"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Content="Cancel"
                    Click="OnCancelClicked"
                    IsCancel="True"
                    Padding="18,7"/>
            <Button Content="{Binding ConfirmText}"
                    Click="OnConfirmClicked"
                    IsDefault="True"
                    IsEnabled="{Binding CanConfirm}"
                    Padding="18,7"/>
        </StackPanel>
    </Grid>
</Window>
