<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.NameDialogView"
        x:DataType="vm:NameDialogViewModel"
        Title="Name" Width="420" Height="215"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackground}">

    <Grid RowDefinitions="*, Auto" Margin="{StaticResource DialogMargin}">
        <StackPanel Grid.Row="0" Classes="DialogField" VerticalAlignment="Center">
            <TextBlock Text="{Binding Header}" Classes="DialogLabel"/>
            <TextBox Text="{Binding Name, Mode=TwoWay}" Classes="DialogInput"/>
            <TextBlock Text="{Binding NameProblem}"
                       IsVisible="{Binding NameProblem, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Classes="DialogError"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Classes="DialogButtons" Margin="{StaticResource DialogButtonRowMargin}">
            <Button Content="Cancel"
                    Click="OnCancelClicked"
                    IsCancel="True"
                    Classes="Dialog"/>
            <Button Content="{Binding ConfirmText}"
                    Click="OnConfirmClicked"
                    IsDefault="True"
                    IsEnabled="{Binding CanConfirm}"
                    Classes="DialogPrimary"/>
        </StackPanel>
    </Grid>
</Window>
