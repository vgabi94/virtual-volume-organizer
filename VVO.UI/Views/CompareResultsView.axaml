<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.CompareResultsView"
        x:DataType="vm:CompareResultsViewModel"
        Title="{Binding WindowTitle}" Width="960" Height="620"
        WindowStartupLocation="CenterOwner"
        Classes="AppWindow">

    <Window.Styles>
        <Style Selector="DataGridRow.Added">
            <Setter Property="Background" Value="{DynamicResource DiffAddedBackground}"/>
        </Style>
        <Style Selector="DataGridRow.Added:selected">
            <Setter Property="Background" Value="{DynamicResource DiffAddedSelectedBackground}"/>
        </Style>
        <Style Selector="DataGridRow.Added TextBlock.StatusSymbol, StackPanel.Added TextBlock.StatusSymbol">
            <Setter Property="Foreground" Value="{DynamicResource DiffAddedForeground}"/>
        </Style>

        <Style Selector="DataGridRow.Removed">
            <Setter Property="Background" Value="{DynamicResource DiffRemovedBackground}"/>
        </Style>
        <Style Selector="DataGridRow.Removed:selected">
            <Setter Property="Background" Value="{DynamicResource DiffRemovedSelectedBackground}"/>
        </Style>
        <Style Selector="DataGridRow.Removed TextBlock.StatusSymbol, StackPanel.Removed TextBlock.StatusSymbol">
            <Setter Property="Foreground" Value="{DynamicResource DiffRemovedForeground}"/>
        </Style>

        <Style Selector="DataGridRow.Changed">
            <Setter Property="Background" Value="{DynamicResource DiffChangedBackground}"/>
        </Style>
        <Style Selector="DataGridRow.Changed:selected">
            <Setter Property="Background" Value="{DynamicResource DiffChangedSelectedBackground}"/>
        </Style>
        <Style Selector="DataGridRow.Changed TextBlock.StatusSymbol, StackPanel.Changed TextBlock.StatusSymbol">
            <Setter Property="Foreground" Value="{DynamicResource DiffChangedForeground}"/>
        </Style>

        <Style Selector="TextBlock.CompareLabel">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.CompareSummary">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="{StaticResource CompareSummaryMargin}"/>
        </Style>
        <Style Selector="StackPanel.CompareSummaryParts">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="{StaticResource CompareSummaryPartSpacing}"/>
            <Setter Property="Margin" Value="{StaticResource CompareSummaryMargin}"/>
        </Style>
        <Style Selector="StackPanel.CompareSummaryParts > StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="{StaticResource CompareSymbolSpacing}"/>
        </Style>
        <Style Selector="StackPanel.CompareSummaryParts TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Window.Modern TextBlock.CompareLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>
        <Style Selector="Window.Modern TextBlock.CompareSummary">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Window.Modern StackPanel.CompareSummaryParts">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Window.Modern Border.ComparePanel">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ContentBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{StaticResource FrameThickness}"/>
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style Selector="TextBlock.StatusSymbol">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="{StaticResource CompareSymbolFontSize}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="{StaticResource CompareMargin}">
        <StackPanel Grid.Row="0" Spacing="{StaticResource CompareHeaderSpacing}" Margin="{StaticResource CompareHeaderMargin}">
            <Grid ColumnDefinitions="70, *">
                <TextBlock Grid.Column="0" Classes="CompareLabel" Text="Source"/>
                <TextBlock Grid.Column="1" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <Grid ColumnDefinitions="70, *">
                <TextBlock Grid.Column="0" Classes="CompareLabel" Text="Target"/>
                <TextBlock Grid.Column="1" Text="{Binding TargetName}" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <TextBlock Classes="CompareSummary" Text="{Binding Summary}"/>
            <StackPanel Classes="CompareSummaryParts">
                <StackPanel Classes="Removed">
                    <TextBlock Classes="StatusSymbol" Text="{x:Static vm:CompareResultsViewModel.RemovedSymbol}"/>
                    <TextBlock Text="{Binding RemovedSummary}"/>
                </StackPanel>
                <StackPanel Classes="Added">
                    <TextBlock Classes="StatusSymbol" Text="{x:Static vm:CompareResultsViewModel.AddedSymbol}"/>
                    <TextBlock Text="{Binding AddedSummary}"/>
                </StackPanel>
                <StackPanel Classes="Changed" IsVisible="{Binding HasChangedSummary}">
                    <TextBlock Classes="StatusSymbol" Text="{x:Static vm:CompareResultsViewModel.ChangedSymbol}"/>
                    <TextBlock Text="{Binding ChangedSummary}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="No differences found."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   IsVisible="{Binding !HasDifferences}"/>

        <Border Grid.Row="1" Classes="ComparePanel" IsVisible="{Binding HasDifferences}">
        <DataGrid ItemsSource="{Binding Rows}"
                  Classes="ExplorerGrid"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  LoadingRow="OnRowLoading">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="46" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Classes="StatusSymbol" Text="{Binding Symbol}" ToolTip.Tip="{Binding StatusName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Path" Width="3*" SortMemberPath="Path">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{DynamicResource VolumeExplorerCellSpacing}"
                                        Background="Transparent"
                                        ToolTip.Tip="{Binding FullPath}">
                                <PathIcon Data="{Binding Icon}"
                                          Classes.FlipY="{Binding IsIconFlipped}"
                                          Width="{StaticResource IconMedium}" Height="{StaticResource IconMedium}"
                                          VerticalAlignment="Center"
                                          Classes="FileTypeIcon"
                                          Tag="{Binding IconKey}"/>
                                <TextBlock Text="{Binding Path}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Change" Binding="{Binding Detail}" Width="*" SortMemberPath="Detail"/>
                <DataGridTextColumn Header="Items" Binding="{Binding Items}" Width="90" SortMemberPath="Items" CellStyleClasses="Number"/>
                <DataGridTextColumn Header="Source Size" Binding="{Binding LeftSize}" Width="*" SortMemberPath="LeftSizeSortPath" CellStyleClasses="Number"/>
                <DataGridTextColumn Header="Target Size" Binding="{Binding RightSize}" Width="*" SortMemberPath="RightSizeSortPath" CellStyleClasses="Number"/>
            </DataGrid.Columns>
        </DataGrid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="{StaticResource CompareFooterMargin}">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource CompareCopySpacing}">
                <Button Content="Copy added"
                        Classes="CompareCopy"
                        IsEnabled="{Binding HasAdded}"
                        ToolTip.Tip="Copy the full paths of added entries, one per line, under the target root"
                        Click="OnCopyAddedClicked"/>
                <Button Content="Copy removed"
                        Classes="CompareCopy"
                        IsEnabled="{Binding HasRemoved}"
                        ToolTip.Tip="Copy the full paths of removed entries, one per line, under the source root"
                        Click="OnCopyRemovedClicked"/>
                <Button Content="Copy changed"
                        Classes="CompareCopy"
                        IsEnabled="{Binding HasChanged}"
                        ToolTip.Tip="Copy the full paths of changed entries, one per line, under the source root"
                        Click="OnCopyChangedClicked"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Classes="DialogButtons">
                <Button Content="{Binding CloseText}"
                        Classes="Dialog"
                        IsCancel="True"
                        Click="OnCloseClicked"/>
                <Button Content="Replace"
                        Classes="DialogPrimary"
                        IsDefault="True"
                        IsVisible="{Binding IsUpdate}"
                        Click="OnUpdateClicked"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
