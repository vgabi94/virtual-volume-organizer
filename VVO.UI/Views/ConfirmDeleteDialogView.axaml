<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.ConfirmDeleteDialogView"
        x:DataType="vm:ConfirmDeleteDialogViewModel"
        Title="{Binding Title}" Width="460" Height="270"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackground}">

    <Grid RowDefinitions="Auto, *, Auto" Margin="{StaticResource DialogMargin}">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
            <PathIcon Grid.Column="0" Classes="DialogAlert" Data="{StaticResource Alert}"/>
            <StackPanel Grid.Column="1" Spacing="{StaticResource DialogContentSpacing}">
                <TextBlock Classes="DialogSubject" Text="{Binding ItemName}"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Message}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Classes="DialogField" VerticalAlignment="Center">
            <TextBlock Text="Type delete to confirm" Classes="DialogLabel"/>
            <TextBox Text="{Binding Confirmation, Mode=TwoWay}" Classes="DialogInput"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Classes="DialogButtons" Margin="{StaticResource DialogButtonRowMargin}">
            <Button Content="Cancel"
                    Click="OnCancelClicked"
                    IsCancel="True"
                    Classes="Dialog"/>
            <Button Content="Delete"
                    Click="OnDeleteClicked"
                    IsDefault="True"
                    IsEnabled="{Binding CanDelete}"
                    Foreground="{DynamicResource DangerBrush}"
                    Classes="DialogPrimary"/>
        </StackPanel>
    </Grid>
</Window>
