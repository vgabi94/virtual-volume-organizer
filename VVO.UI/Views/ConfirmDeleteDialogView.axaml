<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.ConfirmDeleteDialogView"
        x:DataType="vm:ConfirmDeleteDialogViewModel"
        Title="{Binding Title}" Width="460" Height="270"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackground}">

    <Grid RowDefinitions="Auto, *, Auto" Margin="24">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
            <PathIcon Grid.Column="0"
                      Data="{StaticResource Alert}"
                      Width="24" Height="24"
                      VerticalAlignment="Top"
                      Margin="0,2,14,0"
                      Foreground="{DynamicResource DiffRemovedForeground}"/>
            <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock Text="{Binding ItemName}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Text="{Binding Message}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Type delete to confirm" FontWeight="Medium" FontSize="13"/>
            <TextBox Text="{Binding Confirmation, Mode=TwoWay}" Padding="10,8"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Content="Cancel"
                    Click="OnCancelClicked"
                    IsCancel="True"
                    Padding="18,7"/>
            <Button Content="Delete"
                    Click="OnDeleteClicked"
                    IsDefault="True"
                    IsEnabled="{Binding CanDelete}"
                    Foreground="{DynamicResource DiffRemovedForeground}"
                    Padding="18,7"/>
        </StackPanel>
    </Grid>
</Window>
