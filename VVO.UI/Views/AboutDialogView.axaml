<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.AboutDialogView"
        x:DataType="vm:AboutDialogViewModel"
        Title="About" Width="460" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackground}">

    <Grid RowDefinitions="Auto, *, Auto" Margin="24" RowSpacing="14">

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="{Binding AppName}" FontWeight="Bold" FontSize="18"/>
            <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                       FontSize="13"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="{Binding IconsCredit}"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <HyperlinkButton Content="Third-party notices"
                             Click="OnNoticesClicked"
                             FontSize="13"
                             Padding="0"
                             HorizontalAlignment="Left"/>
        </StackPanel>

        <Button Grid.Row="2"
                Content="Close"
                Click="OnCloseClicked"
                IsDefault="True"
                IsCancel="True"
                HorizontalAlignment="Right"
                Padding="18,7"/>
    </Grid>
</Window>
