<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.AboutDialogView"
        x:DataType="vm:AboutDialogViewModel"
        Title="About" Width="460" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackground}">

    <Grid RowDefinitions="Auto, *, Auto" Margin="{StaticResource DialogMargin}" RowSpacing="{StaticResource DialogRowSpacing}">

        <StackPanel Grid.Row="0" Spacing="{StaticResource DialogTitleSpacing}">
            <TextBlock Classes="DialogTitle" Text="{Binding AppName}"/>
            <TextBlock Classes="DialogNote" Text="{Binding Version, StringFormat='Version {0}'}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="{StaticResource DialogNoteSpacing}">
            <TextBlock Classes="DialogNote" Text="{Binding IconsCredit}"/>
            <HyperlinkButton Classes="DialogLink"
                             Content="GitHub"
                             NavigateUri="{Binding RepositoryUrl}"/>
            <HyperlinkButton Classes="DialogLink"
                             Content="Third-party notices"
                             Click="OnNoticesClicked"/>
        </StackPanel>

        <Button Grid.Row="2"
                Content="Close"
                Click="OnCloseClicked"
                IsDefault="True"
                IsCancel="True"
                HorizontalAlignment="Right"
                Classes="Dialog"/>
    </Grid>
</Window>
