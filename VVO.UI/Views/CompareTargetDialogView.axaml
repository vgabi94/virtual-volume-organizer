<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.CompareTargetDialogView"
        x:DataType="vm:CompareTargetDialogViewModel"
        x:Name="DialogWindow"
        Title="Compare Against" Width="480" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackground}">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="{StaticResource DialogMargin}">
        <TextBlock Grid.Row="0" Text="Compare against a catalogued volume" Classes="DialogLabel" Margin="{StaticResource DialogLabelMargin}"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}" SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="{StaticResource DialogListItemMargin}">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                        <TextBlock Classes="ItemSubtitle" Text="{Binding Path}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Classes="DialogField" Margin="{StaticResource DialogSectionMargin}">
            <TextBlock Text="...or against a folder on disk" Classes="DialogLabel"/>
            <Grid ColumnDefinitions="*, Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding LiveFolderPath, Mode=TwoWay}"
                         PlaceholderText="Click Browse to choose a folder..."
                         IsReadOnly="True"
                         Classes="DialogInput"/>
                <Button Grid.Column="1"
                        Content="Browse..."
                        Classes="DialogBrowse"
                        Command="{Binding BrowseFolderCommand}"
                        CommandParameter="{Binding #DialogWindow}"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Classes="DialogButtons" Margin="{StaticResource DialogButtonRowMargin}">
            <Button Content="Cancel"
                    Click="OnCancelClicked"
                    IsCancel="True"
                    Classes="Dialog"/>
            <Button Content="Compare"
                    Click="OnCompareClicked"
                    IsDefault="True"
                    IsEnabled="{Binding CanCompare}"
                    Classes="DialogPrimary"/>
        </StackPanel>
    </Grid>
</Window>
