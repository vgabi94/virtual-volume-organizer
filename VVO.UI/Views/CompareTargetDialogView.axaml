<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VVO.UI.ViewModels"
        x:Class="VVO.UI.Views.CompareTargetDialogView"
        x:DataType="vm:CompareTargetDialogViewModel"
        x:Name="DialogWindow"
        Title="Compare Against" Width="480" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource SystemRegionColor}">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="24">
        <TextBlock Grid.Row="0" Text="Compare against a catalogued volume" FontWeight="Medium" FontSize="13" Margin="0,0,0,6"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}" SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.8"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Spacing="6" Margin="0,16,0,0">
            <TextBlock Text="...or against a folder on disk" FontWeight="Medium" FontSize="13"/>
            <Grid ColumnDefinitions="*, Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding LiveFolderPath, Mode=TwoWay}"
                         PlaceholderText="Click Browse to choose a folder..."
                         IsReadOnly="True"
                         Padding="10,8"/>
                <Button Grid.Column="1"
                        Content="Browse..."
                        Margin="8,0,0,0"
                        Padding="14,8"
                        Command="{Binding BrowseFolderCommand}"
                        CommandParameter="{Binding #DialogWindow}"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Content="Cancel"
                    Click="OnCancelClicked"
                    IsCancel="True"
                    Padding="18,7"/>
            <Button Content="Compare"
                    Click="OnCompareClicked"
                    IsDefault="True"
                    IsEnabled="{Binding CanCompare}"
                    Padding="18,7"/>
        </StackPanel>
    </Grid>
</Window>
