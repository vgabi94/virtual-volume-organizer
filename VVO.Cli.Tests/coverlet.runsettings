<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage of our own code: generated sources and the process entry point are left out.
     Program.cs is exercised through a real process by the hardening tests instead.
     Passed to dotnet test as its settings file when measuring. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Include>[vvo]*</Include>
          <ExcludeByFile>**/obj/**/*.cs,**/Program.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
