<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Short, so agents and shells can call it the way they call git or dotnet -->
    <AssemblyName>vvo</AssemblyName>
    <RootNamespace>VVO.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VVO.Core\VVO.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded as the GUI embeds them, so the single file carries the notices it has to distribute -->
    <EmbeddedResource Include="..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="..\LICENSE" LogicalName="LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

</Project>
